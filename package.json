{
  "name": "billkeeper",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0 --port 3026",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1 --port 3026",
    "check": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "backup": "node --import tsx --env-file-if-exists=.env.local scripts/backup.ts"
  },
  "dependencies": {
    "next": "15.5.28",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "better-sqlite3": "12.11.1",
    "lucide-react": "0.546.0",
    "@google/genai": "2.21.0",
    "@aws-sdk/client-s3": "3.1152.0"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "@types/node": "^22.0.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.3",
    "@types/better-sqlite3": "^7.6.13",
    "tsx": "4.23.12",
    "@playwright/test": "1.61.1"
  },
  "type": "module"
}
