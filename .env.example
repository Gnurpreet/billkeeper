APP_URL=http://localhost:3026
DATABASE_PATH=./data/billkeeper.sqlite
DOCUMENTS_PATH=./data/documents
# Optional: scanning. Manual receipt entry works without this.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
# Optional: password recovery, using a verified sender.
RESEND_API_KEY=
EMAIL_FROM=
# Optional: private Hetzner storage. Leave all blank for private local files.
HETZNER_OS_ENDPOINT=
HETZNER_OS_REGION=eu-central-1
HETZNER_OS_BUCKET=
HETZNER_OS_ACCESS_KEY=
HETZNER_OS_SECRET_KEY=
